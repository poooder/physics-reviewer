# Public domain that points to this server's public IP. Do not include http:// or https://.
DOMAIN=reviewer.example.edu

# Create a bcrypt hash with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'choose-a-long-password'
# In this file, replace every $ in the generated hash with $$ so Docker Compose preserves it.
BASIC_AUTH_USER=reviewer
BASIC_AUTH_HASH=$$2a$$14$$replace_with_your_escaped_bcrypt_hash

QWEN_API_KEY=replace_with_your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_TEMPERATURE=0.2

MAX_PAPER_CHARS=120000
LITERATURE_SEARCH_ENABLED=true
LITERATURE_SEARCH_LIMIT=5
SEMANTIC_SCHOLAR_API_KEY=
VECTOR_STORE_DIR=/data/chroma_store
LITERATURE_MAX_DISTANCE=0.8
DATABASE_URL=sqlite:////data/physics_reviewer.db
TASK_WORKER_COUNT=2
ROUTER_MAX_SPECIALIST_CALLS=3
CACHE_ENABLED=true
LITERATURE_CACHE_TTL_SECONDS=86400
REVIEW_CACHE_TTL_SECONDS=2592000
QWEN_REQUEST_TIMEOUT_SECONDS=120
QWEN_RETRY_ATTEMPTS=2
EMBEDDING_REQUEST_TIMEOUT_SECONDS=45
